---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { fetchProjects, GITHUB_USERNAME } from '../lib/github';

const { projects, usedFallback } = await fetchProjects();
---

<BaseLayout title="项目 - Morgan" description="Morgan 的开源仓库和个人作品。" titleKey="meta.projectsTitle" descriptionKey="meta.projectsDescription">
    <header class="page-head">
        <div class="container">
            <p class="eyebrow" data-i18n="home.projectsIndex">02 / 项目</p>
            <h1 data-i18n="projects.title">项目</h1>
            <p class="lede" data-i18n="projects.lede">开源仓库和个人作品。</p>
            <p class="page-count" data-i18n="projects.count" data-i18n-n={projects.length}>共 {projects.length} 个</p>
        </div>
    </header>

    <div class="container section">
        {
            usedFallback && (
                <p class="fallback-note" role="status">
                    <span aria-hidden="true">⚠︎</span>
                    <span data-i18n="projects.fallbackNote">
                        GitHub 接口暂不可用，以下为本地记录的项目。
                    </span>
                </p>
            )
        }

        <p class="source-note">
            <span data-i18n="projects.source">数据来源</span>
            {
                usedFallback ? (
                    <span data-i18n="projects.localSource">本地记录</span>
                ) : (
                    <a href={`https://github.com/${GITHUB_USERNAME}`} target="_blank" rel="noopener noreferrer">
                        github.com/{GITHUB_USERNAME}
                    </a>
                )
            }
        </p>

        <div class="projects-grid">
            {
                projects.map((project, index) => (
                    <ProjectCard {...project} position={`${String(index + 1).padStart(2, '0')}`} />
                ))
            }
        </div>
    </div>
</BaseLayout>

<style>
    .page-count {
        margin-top: 1.25rem;
        font-family: var(--font-mono);
        font-size: 0.8125rem;
        letter-spacing: 0.12em;
        color: var(--color-text-tertiary);
    }

    .section {
        padding: 2.5rem 1.5rem 5rem;
    }

    .fallback-note {
        display: flex;
        align-items: flex-start;
        gap: 0.625rem;
        margin-bottom: 1.5rem;
        padding: 0.875rem 1rem;
        background: var(--color-primary-light);
        border-left: 3px solid var(--color-primary);
        font-size: 0.875rem;
        line-height: 1.6;
        color: var(--color-text-secondary);
    }

    .source-note {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 2rem;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.08em;
        color: var(--color-text-tertiary);
    }

    .source-note a {
        color: var(--color-primary);
        text-decoration: none;
        border-bottom: 1px solid var(--color-border);
    }

    .source-note a:hover {
        border-bottom-color: var(--color-primary);
    }

    .projects-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.5rem;
    }

    @media (max-width: 640px) {
        .section {
            padding: 2rem 1.5rem 3.5rem;
        }
    }
</style>
