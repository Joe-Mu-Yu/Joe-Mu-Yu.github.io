---
import BaseLayout from '../layouts/BaseLayout.astro';
import InteractiveMap from '../components/InteractiveMap.astro';
---

<BaseLayout title="About - Morgan">
  <div class="container section">
    <h1>关于我</h1>
    <div class="content">
      <p>Hi, 我是 Morgan。</p>
      <p>编程爱好者 / AI爱好者 / 探索生活的美好</p>
      
      <InteractiveMap />
      
      <h2>我的技能</h2>
      <ul>
        <li>Frontend: React, Vue, Astro</li>
        <li>Backend: Node.js, Python</li>
        <li>DevOps: Docker, CI/CD</li>
      </ul>

      <h2>联系我</h2>
      <p>
        Email: <a href="mailto:joerocker516@gmail.com">joerocker516@gmail.com</a><br/>
        GitHub: <a href="https://github.com/Joe-Mu-Yu">@Joe-Mu-Yu</a>
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  .section {
    padding: 5rem 1rem 4rem;
    max-width: var(--max-width-narrow);
    margin: 0 auto;
  }
  
  h1 {
    font-size: 2.5rem;
    margin-bottom: 2rem;
    color: var(--color-text);
    text-align: center;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  h2 {
    font-size: 1.5rem;
    margin: 2.5rem 0 1.25rem;
    color: var(--color-text);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .content {
    font-size: 1rem;
    color: var(--color-text-secondary);
    line-height: 1.8;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0;
  }
  
  ul li {
    padding: 0.75rem 1rem;
    margin: 0.5rem 0;
    
    /* 液态玻璃效果 */
    background: var(--glass-bg);
    backdrop-filter: var(--backdrop-blur);
    -webkit-backdrop-filter: var(--backdrop-blur);
    border: 1px solid var(--glass-border);
    border-radius: var(--border-radius-lg);
    transition: all 0.2s ease;
  }
  
  ul li:hover {
    background: var(--glass-bg-strong);
    transform: translateX(4px);
    border-color: rgba(255, 255, 255, 0.25);
  }

  a {
    color: var(--color-primary);
    text-decoration: none;
    padding: 0.25rem 0.5rem;
    border-radius: 6px;
    transition: all 0.2s ease;
    font-weight: 500;
  }
  
  a:hover {
    background: var(--color-primary-light);
  }
</style>
