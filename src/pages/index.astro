---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import HeroCollage from '../components/HeroCollage.astro';
import Button from '../components/Button.astro';
import { fetchProjects } from '../lib/github';
import { getSortedPosts } from '../lib/posts';

const posts = (await getSortedPosts())
    .slice(0, 3)
    .map((post) => ({
        title: post.frontmatter.title,
        description: post.frontmatter.description ?? '',
        date: new Date(post.frontmatter.date),
        tags: post.frontmatter.tags,
        href: post.url,
    }));

const { projects, usedFallback } = await fetchProjects();
const featuredProjects = projects.slice(0, 3);
const lifePostCount = 0;
---

<BaseLayout title="Morgan — 个人博客" description="Morgan 的个人博客：代码、AI 与生活记录。" titleKey="meta.homeTitle" descriptionKey="meta.homeDescription">
    <section class="hero container">
        <div class="hero-copy">
            <p class="eyebrow" data-i18n="home.eyebrow">个人博客 / 2019—至今</p>
            <h1 class="hero-title" data-i18n="home.greeting">你好，我是 Morgan</h1>
            <p class="hero-bio" data-i18n="home.bio">
                写代码、跟模型较劲，也记录一些没被写进文档的东西。这里的文章大多来自真实踩坑：踩过、查过、写下结论。
            </p>
            <div class="hero-actions">
                <Button href="/posts" data-i18n="home.primaryCta">看文章</Button>
                <Button href="https://github.com/Joe-Mu-Yu" variant="secondary">
                    <span data-i18n="home.secondaryCta">GitHub</span>
                </Button>
            </div>
        </div>

        <div class="hero-collage">
            <HeroCollage />
        </div>
    </section>

    <section class="section container" aria-labelledby="posts-heading">
        <header class="section-head">
            <div>
                <p class="section-index" data-i18n="home.postsIndex">01 / 文章</p>
                <h2 id="posts-heading" data-i18n="home.posts">文章</h2>
            </div>
            <Button href="/posts" variant="ghost">
                <span data-i18n="home.viewAllPosts">全部文章</span>
            </Button>
        </header>

        <div class="post-list">
            {posts.map((post) => <ArticleCard {...post} />)}
        </div>
    </section>

    <section class="section container" aria-labelledby="projects-heading">
        <header class="section-head">
            <div>
                <p class="section-index" data-i18n="home.projectsIndex">02 / 项目</p>
                <h2 id="projects-heading" data-i18n="home.projects">项目</h2>
            </div>
            <Button href="/projects" variant="ghost">
                <span data-i18n="home.viewAllProjects">全部项目</span>
            </Button>
        </header>

        {
            usedFallback && (
                <p class="fallback-note" role="status">
                    <span aria-hidden="true">⚠︎</span>
                    <span data-i18n="home.projectsFallback">
                        GitHub 接口暂不可用，以下为本地记录的项目。
                    </span>
                </p>
            )
        }

        <div class="project-grid">
            {
                featuredProjects.map((project, index) => (
                    <ProjectCard {...project} position={`${String(index + 1).padStart(2, '0')}`} />
                ))
            }
        </div>
    </section>

    <section class="section container" aria-labelledby="life-heading">
        <header class="section-head">
            <div>
                <p class="section-index" data-i18n="home.lifeIndex">03 / 生活</p>
                <h2 id="life-heading" data-i18n="home.life">生活</h2>
            </div>
            <Button href="/life" variant="ghost">
                <span data-i18n="home.viewAllLife">进入生活</span>
            </Button>
        </header>

        <div class="empty-state" data-reveal>
            <p class="empty-index">000</p>
            <h2 data-i18n="life.emptyTitle">这里还没有文章</h2>
            <p data-i18n="life.emptyBody">
                生活栏目还没有发布任何内容。等第一篇写完，它会出现在这个位置。
            </p>
            <p class="life-count" data-i18n="life.count" data-i18n-n={lifePostCount}>共 {lifePostCount} 篇</p>
        </div>
    </section>
</BaseLayout>

<style>
    .hero {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 0.92fr);
        gap: 4rem;
        align-items: center;
        padding: 5rem 1.5rem 6rem;
    }

    .hero-copy {
        max-width: 34rem;
    }

    .hero-title {
        margin-top: 1.25rem;
        font-family: var(--font-display);
        font-size: clamp(2.75rem, 6.5vw, 5.25rem);
        font-weight: 800;
        line-height: 0.94;
        letter-spacing: -0.04em;
        text-wrap: balance;
    }

    .hero-bio {
        margin-top: 1.75rem;
        font-size: 1.0625rem;
        line-height: 1.8;
        color: var(--color-text-secondary);
        max-width: 46ch;
    }

    .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 2.25rem;
    }

    .section {
        padding: 4.5rem 1.5rem;
        border-top: 1px solid var(--color-rule);
    }

    .section-head {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 1.5rem;
        margin-bottom: 2.5rem;
    }

    .section-head h2 {
        margin-top: 0.5rem;
        font-family: var(--font-display);
        font-size: clamp(2rem, 4.5vw, 3rem);
        font-weight: 800;
        letter-spacing: -0.035em;
        line-height: 1;
        text-transform: uppercase;
    }

    .post-list {
        display: flex;
        flex-direction: column;
    }

    .project-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.5rem;
    }

    .fallback-note {
        display: flex;
        align-items: flex-start;
        gap: 0.625rem;
        margin-bottom: 1.75rem;
        padding: 0.875rem 1rem;
        background: var(--color-primary-light);
        border-left: 3px solid var(--color-primary);
        font-size: 0.875rem;
        line-height: 1.6;
        color: var(--color-text-secondary);
    }

    .life-count {
        margin-top: 1.5rem;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.1em;
        color: var(--color-text-tertiary);
    }

    @media (max-width: 1024px) {
        .hero {
            grid-template-columns: 1fr;
            gap: 3.5rem;
            padding: 3.5rem 1.5rem 4.5rem;
        }

        .hero-copy {
            max-width: none;
        }
    }

    @media (max-width: 640px) {
        .hero {
            padding: 2.5rem 1.5rem 4rem;
        }

        .section {
            padding: 3.5rem 1.5rem;
        }

        .section-head {
            flex-direction: column;
            align-items: flex-start;
            gap: 1.25rem;
        }
    }
</style>
