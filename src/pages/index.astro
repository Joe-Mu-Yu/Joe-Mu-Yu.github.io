---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CategoryTag from '../components/CategoryTag.astro';
import Button from '../components/Button.astro';

// 示例文章数据 - 请替换为你自己的内容
// 获取最新的文章（取前3篇）
const allPosts = await Astro.glob('./posts/*.md');
const posts = allPosts
  .sort((a, b) => new Date(b.frontmatter.date).valueOf() - new Date(a.frontmatter.date).valueOf())
  .slice(0, 3)
  .map(post => ({
    title: post.frontmatter.title,
    description: post.frontmatter.description,
    date: new Date(post.frontmatter.date),
    tags: post.frontmatter.tags,
    href: post.url
  }));

// 从 GitHub API 获取项目数据（与项目页同步）
const GITHUB_USERNAME = 'Joe-Mu-Yu';
const GITHUB_API = `https://api.github.com/users/${GITHUB_USERNAME}/repos?sort=updated&per_page=50`;

const manualProjects = [
  {
    title: 'Joe-Mu-Yu.github.io',
    description: '个人博客网站，采用 Astro 构建，白色透明毛玻璃设计风格',
    href: 'https://github.com/Joe-Mu-Yu/Joe-Mu-Yu.github.io',
    icon: '🌐',
    language: 'TypeScript',
    stars: 0,
    forks: 0
  }
];

async function fetchGitHubRepos() {
  try {
    const response = await fetch(GITHUB_API);
    if (!response.ok) throw new Error('Failed to fetch GitHub repos');
    const repos = await response.json();
    
    const originalRepos = repos.filter(repo => !repo.fork);
    
    const githubProjects = originalRepos.map(repo => ({
      title: repo.name,
      description: repo.description || '暂无描述',
      href: repo.html_url,
      language: repo.language,
      stars: repo.stargazers_count,
      forks: repo.forks_count,
      updatedAt: new Date(repo.updated_at).toLocaleDateString('zh-CN'),
      icon: getRepoIcon(repo.name)
    }));
    
    const existingTitles = new Set(githubProjects.map(p => p.title));
    const additionalProjects = manualProjects.filter(p => !existingTitles.has(p.title));
    
    return [...githubProjects, ...additionalProjects];
  } catch (error) {
    console.error('Error fetching GitHub repos:', error);
    return manualProjects;
  }
}

function getRepoIcon(repoName: string): string {
  const iconMap: Record<string, string> = {
    'OpenIsle': '🏝️',
    'weekly': '📰',
    'pythermalcomfort': '🌡️',
    'Learn_Prompting': '📚',
    'blog': '📝',
    'website': '🌐',
    'app': '📱',
    'tool': '🔧',
    'ai': '🤖',
    'web': '🕸️'
  };
  
  for (const [key, icon] of Object.entries(iconMap)) {
    if (repoName.toLowerCase().includes(key.toLowerCase())) {
      return icon;
    }
  }
  
  return '🚀';
}

const allProjects = await fetchGitHubRepos();
const projects = allProjects.slice(0, 3);

const categories = ['前端', '项目', '工具', '生活'];
---

<BaseLayout title="Morgan - Personal Blog">
  <section class="hero container">
    <div class="hero-content">
      <div class="hero-text">
        <h1 data-i18n="home.greeting">Hi, Morgan</h1>
        <p class="bio" data-i18n="home.bio">
          编程爱好者 / AI爱好者 / 探索生活的美好
        </p>
        <div class="social-links">
          <Button variant="outline" href="https://github.com/Joe-Mu-Yu">GitHub</Button>
        </div>
      </div>
      <div class="hero-avatar">
        <img src="/avatar.jpg" alt="Morgan" />
      </div>
    </div>
  </section>

  <section class="section container">
    <div class="section-header">
      <h2 data-i18n="home.articles">文章</h2>
      <div class="categories">
        {categories.map(cat => <CategoryTag tag={cat} />)}
      </div>
    </div>
    
    <div class="posts-grid">
      {posts.map(post => (
        <ArticleCard {...post} />
      ))}
    </div>
    
    <div class="view-more">
      <Button href="/posts" variant="secondary"><span data-i18n="home.viewAllPosts">查看所有文章</span></Button>
    </div>
  </section>

  <section class="section container">
    <div class="section-header">
      <h2 data-i18n="home.projectsTitle">项目</h2>
    </div>
    
    <div class="projects-grid">
      {projects.map(project => (
        <ProjectCard {...project} />
      ))}
    </div>
    
    <div class="view-more">
      <Button href="/projects" variant="secondary"><span data-i18n="home.viewAllProjects">查看所有项目</span></Button>
    </div>
  </section>

  <section class="section container">
    <div class="section-header">
      <h2 data-i18n="home.lifeTitle">生活</h2>
    </div>
    
    <div class="life-content">
      <p class="life-description">分享生活中的点滴瞬间和感悟</p>
      <div class="life-placeholder">
        <p>生活相关的文章将显示在这里...</p>
      </div>
    </div>
    
    <div class="view-more">
      <Button href="/life" variant="secondary"><span data-i18n="home.viewAllLife">查看全部生活</span></Button>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 8rem 1rem 5rem;
  }

  .hero-content {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4rem;
    max-width: 960px;
    margin: 0 auto;
    
    /* 液态玻璃容器 */
    background: var(--glass-bg-light);
    backdrop-filter: var(--backdrop-blur);
    -webkit-backdrop-filter: var(--backdrop-blur);
    border-radius: var(--border-radius-lg);
    padding: 3rem;
    border: 1px solid var(--glass-border);
    box-shadow: var(--shadow-glass);
  }

  .hero-text {
    flex: 1;
    text-align: left;
    max-width: 540px;
  }

  .hero-avatar {
    flex-shrink: 0;
  }

  .hero-avatar img {
    width: 200px;
    height: 200px;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: var(--shadow-glass);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    border: 4px solid var(--glass-border);
  }

  .hero-avatar img:hover {
    transform: scale(1.03);
  }

  h1 {
    font-size: 3rem;
    font-weight: 700;
    margin-bottom: 1.25rem;
    color: var(--color-text);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .bio {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin-bottom: 2rem;
    max-width: 480px;
  }

  .social-links {
    display: flex;
    justify-content: flex-start;
    gap: 0.75rem;
  }

  .section {
    padding: 5rem 1rem;
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .section-header {
    margin-bottom: 2.5rem;
  }

  h2 {
    font-size: 1.75rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
    color: var(--color-text);
    letter-spacing: -0.01em;
  }

  .categories {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .posts-grid {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .life-content {
    /* 液态玻璃效果 */
    background: var(--glass-bg);
    backdrop-filter: var(--backdrop-blur);
    -webkit-backdrop-filter: var(--backdrop-blur);
    border: 1px solid var(--glass-border);
    box-shadow: var(--shadow-glass);
    border-radius: var(--border-radius-lg);
    padding: 2rem;
    text-align: center;
  }

  .life-description {
    font-size: 1rem;
    color: var(--color-text-secondary);
    margin-bottom: 1.5rem;
    line-height: 1.8;
  }

  .life-placeholder {
    padding: 3rem 1.5rem;
    color: var(--color-text-tertiary);
    font-style: italic;
    background: var(--glass-bg-light);
    border-radius: var(--border-radius-lg);
    border: 1px dashed var(--glass-border);
  }

  .view-more {
    margin-top: 2rem;
    text-align: center;
  }

  @media (max-width: 768px) {
    .hero {
      padding: 6rem 1rem 4rem;
    }
    
    h1 { 
      font-size: 2.25rem; 
    }
    
    .hero-content {
      flex-direction: column;
      text-align: center;
      gap: 2.5rem;
    }

    .hero-text {
      text-align: center;
      max-width: 100%;
    }

    .social-links {
      justify-content: center;
    }

    .hero-avatar img {
      width: 160px;
      height: 160px;
    }
    
    .bio {
      margin: 0 auto 2rem;
    }
  }
</style>

<script>
  import { translations, type Language } from '../i18n/index.ts';

  function updateLanguage() {
    const lang = (localStorage.getItem('language') || 'zh') as Language;
    const elements = document.querySelectorAll('[data-i18n]');
    
    elements.forEach(el => {
      const key = el.getAttribute('data-i18n');
      if (key) {
        const keys = key.split('.');
        let value: any = translations[lang];
        
        for (const k of keys) {
          if (value && typeof value === 'object') {
            value = value[k];
          }
        }
        
        if (typeof value === 'string') {
          el.textContent = value;
        }
      }
    });
  }

  // 页面加载时更新语言
  updateLanguage();

  // 监听语言切换事件
  window.addEventListener('languageChanged', () => {
    updateLanguage();
  });
</script>
