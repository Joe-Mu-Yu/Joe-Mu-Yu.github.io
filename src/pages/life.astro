---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="生活 - Morgan">
  <div class="container section">
    <h1>生活</h1>
    <div class="content">
      <p>分享生活中的点滴瞬间和感悟</p>
      
      <div class="life-posts">
        <p class="placeholder">生活相关的文章将显示在这里...</p>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .section {
    padding: 5rem 1rem 4rem;
    max-width: var(--max-width-narrow);
    margin: 0 auto;
  }
  
  h1 {
    font-size: 2.5rem;
    margin-bottom: 2rem;
    color: var(--color-text);
    text-align: center;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .content {
    font-size: 1rem;
    color: var(--color-text-secondary);
    line-height: 1.8;
  }

  .life-posts {
    margin-top: 2.5rem;
  }

  .placeholder {
    text-align: center;
    padding: 3rem 1.5rem;
    color: var(--color-text-tertiary);
    font-style: italic;
    background: var(--color-bg-secondary);
    border-radius: var(--border-radius);
  }
</style>
