---
import BaseLayout from './BaseLayout.astro';
import CategoryTag from '../components/CategoryTag.astro';
import PostNavigation from '../components/PostNavigation.astro';
import { getSortedPosts } from '../lib/posts';

interface Props {
  frontmatter: {
    title: string;
    description?: string;
    date: string;
    tags?: string[];
    layout?: string;
  };
}

const { frontmatter } = Astro.props;
const { title, description, date, tags = [] } = frontmatter;

const formattedDate = new Date(date).toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const sortedPosts = await getSortedPosts();

const currentIndex = sortedPosts.findIndex((post) => post.frontmatter.title === title);
const prevPost = currentIndex < sortedPosts.length - 1 ? sortedPosts[currentIndex + 1] : null;
const nextPost = currentIndex > 0 ? sortedPosts[currentIndex - 1] : null;
---

<BaseLayout title={`${title} - Morgan`} description={description}>
  <article class="post-page" lang="zh-CN">
    <!-- Static editorial masthead: no parallax, no glass. The article body
         stays completely still so reading is never disturbed. -->
    <header class="post-head">
      <div class="container">
        <div class="post-meta">
          <time datetime={date} class="post-date">{formattedDate}</time>
          {
            tags.length > 0 && (
              <div class="post-tags">
                {tags.map((tag) => (
                  <CategoryTag tag={tag} />
                ))}
              </div>
            )
          }
        </div>
        <h1 class="post-title">{title}</h1>
        {description && <p class="post-description">{description}</p>}
        <p class="post-original-language" data-i18n="post.originalLanguage" data-interface-lang lang="zh-CN">本文为中文原文</p>
      </div>
    </header>

    <div class="container post-body">
      <div class="prose">
        <slot />
      </div>

      <PostNavigation
        prevPost={prevPost ? { title: prevPost.frontmatter.title, href: prevPost.url || '' } : null}
        nextPost={nextPost ? { title: nextPost.frontmatter.title, href: nextPost.url || '' } : null}
      />
    </div>
  </article>

  <button type="button" class="back-to-top" data-back-to-top data-i18n-attr="aria-label:post.backToTop" aria-label="返回顶部">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="18 15 12 9 6 15"></polyline>
    </svg>
  </button>
</BaseLayout>

<style>
  .post-head {
    padding: 5.5rem 1.5rem 2.5rem;
    border-bottom: 1px solid var(--color-rule);
  }

  .post-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
  }

  .post-date {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--color-text-tertiary);
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .post-title {
    margin-top: 1.5rem;
    max-width: 22ch;
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 6vw, 3.75rem);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .post-description {
    margin-top: 1.5rem;
    max-width: 52ch;
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--color-text-secondary);
  }

  .post-original-language {
    margin-top: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-tertiary);
  }

  .post-body {
    padding: 3rem 1.5rem 4rem;
    max-width: var(--max-width-narrow);
  }

  .back-to-top {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    width: var(--tap-target);
    height: var(--tap-target);
    display: grid;
    place-items: center;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    cursor: pointer;
    z-index: 90;
    opacity: 0;
    transform: translateY(10px);
    pointer-events: none;
    transition:
      opacity 0.25s var(--ease-snap),
      transform 0.25s var(--ease-snap),
      color 0.2s;
  }

  .back-to-top.is-visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .back-to-top:hover,
  .back-to-top:focus-visible {
    color: var(--color-primary);
    border-color: var(--color-primary);
  }

  @media (max-width: 768px) {
    .post-head {
      padding: 3.5rem 1.5rem 2rem;
    }

    .post-body {
      padding: 2.25rem 1.5rem 3rem;
    }

    .back-to-top {
      bottom: 1.25rem;
      right: 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .back-to-top {
      transition: none;
      transform: none;
    }
  }
</style>

<script>
  const backToTop = document.querySelector<HTMLButtonElement>('[data-back-to-top]');

  if (backToTop) {
    // Shares the page's scroll listener budget; only toggles a class.
    let ticking = false;
    const sync = () => {
      backToTop.classList.toggle('is-visible', window.scrollY > 600);
      ticking = false;
    };

    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(sync);
      },
      { passive: true },
    );
    sync();

    backToTop.addEventListener('click', () => {
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reducedMotion ? 'auto' : 'smooth' });
    });
  }
</script>
