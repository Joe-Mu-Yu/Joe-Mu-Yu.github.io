---
// Rendered twice (desktop and mobile nav), so this is data-attribute driven
// rather than bound to a single element id.
---

<button
    type="button"
    class="theme-toggle"
    data-theme-toggle
    data-i18n-attr="aria-label:nav.theme"
    aria-label="切换主题"
>
    <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4.5"></circle>
        <path d="M12 2v2"></path>
        <path d="M12 20v2"></path>
        <path d="m4.9 4.9 1.4 1.4"></path>
        <path d="m17.7 17.7 1.4 1.4"></path>
        <path d="M2 12h2"></path>
        <path d="M20 12h2"></path>
        <path d="m4.9 19.1 1.4-1.4"></path>
        <path d="m17.7 6.3 1.4-1.4"></path>
    </svg>
    <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
    </svg>
</button>

<style>
    .theme-toggle {
        display: inline-grid;
        align-items: center;
        justify-content: center;
        width: var(--tap-target);
        height: var(--tap-target);
        background: transparent;
        border: 1px solid var(--color-border);
        color: var(--color-text-secondary);
        cursor: pointer;
        transition:
            color 0.2s var(--ease-snap),
            border-color 0.2s var(--ease-snap),
            transform 0.25s var(--ease-out);
    }

    .theme-toggle:hover {
        color: var(--color-text);
        border-color: var(--color-text);
        transform: rotate(-12deg);
    }

    .icon-sun,
    .icon-moon {
        grid-area: 1 / 1;
    }

    :global(:not([data-theme='dark'])) .icon-sun {
        display: none;
    }

    :global([data-theme='dark']) .icon-moon {
        display: none;
    }
</style>

<script>
    document.querySelectorAll('[data-theme-toggle]').forEach((toggle) => {
        toggle.addEventListener('click', () => {
            const current = document.documentElement.getAttribute('data-theme');
            const next = current === 'dark' ? 'light' : 'dark';

            document.documentElement.setAttribute('data-theme', next);
            try {
                localStorage.setItem('theme', next);
            } catch (error) {
                // Storage can be unavailable; the in-memory switch still works.
            }
        });
    });
</script>
