---
interface Props {
  title: string;
  description: string;
  href: string;
  icon?: string;
  language?: string;
  stars?: number;
  forks?: number;
  updatedAt?: string;
}

const { title, description, href, icon, language, stars = 0, forks = 0, updatedAt } = Astro.props;
---

<a href={href} class="project-card" target="_blank" rel="noopener noreferrer">
  <div class="header">
    {icon && <span class="icon">{icon}</span>}
    <h3>{title}</h3>
  </div>
  <p>{description}</p>
  <div class="meta">
    {language && <span class="language">
      <span class="language-dot"></span>
      {language}
    </span>}
    <div class="stats">
      {stars > 0 && <span class="stat" title="Stars">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
        {stars}
      </span>}
      {forks > 0 && <span class="stat" title="Forks">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="18" r="3"></circle><circle cx="6" cy="6" r="3"></circle><circle cx="18" cy="6" r="3"></circle><path d="M6 21V9a9 9 0 0 0 6 3"></path><path d="M18 9a9 9 0 0 0-6-3"></path></svg>
        {forks}
      </span>}
    </div>
  </div>
  {updatedAt && <time class="updated">Updated {updatedAt}</time>}
</a>

<style>
  .project-card {
    display: block;
    padding: 1.5rem;
    background: var(--glass-bg);
    backdrop-filter: var(--backdrop-blur);
    -webkit-backdrop-filter: var(--backdrop-blur);
    border-radius: var(--border-radius);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    height: 100%;
    box-shadow: var(--shadow-glass);
    border: 1px solid var(--glass-border);
    position: relative;
    overflow: hidden;
  }
  
  .project-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background: linear-gradient(90deg, var(--color-primary), var(--color-primary-hover));
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .project-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
    background: var(--glass-bg-strong);
    border-color: var(--color-border);
  }
  
  .project-card:hover::before {
    opacity: 1;
  }

  .header {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: 0.75rem;
  }

  .icon {
    font-size: 1.25rem;
    transition: transform 0.3s ease;
  }
  
  .project-card:hover .icon {
    transform: scale(1.1);
  }

  h3 {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-text);
    transition: color 0.2s ease;
    letter-spacing: -0.01em;
  }
  
  .project-card:hover h3 {
    color: var(--color-primary);
  }

  p {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: 1rem;
  }
  
  .meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-top: 0.875rem;
    border-top: 1px solid var(--color-border-light);
  }
  
  .language {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.75rem;
    color: var(--color-text-tertiary);
    font-weight: 500;
  }
  
  .language-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-primary);
    display: inline-block;
  }
  
  .stats {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }
  
  .stat {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.75rem;
    color: var(--color-text-tertiary);
    font-weight: 500;
  }
  
  .stat svg {
    opacity: 0.7;
  }
  
  .updated {
    display: block;
    margin-top: 0.75rem;
    font-size: 0.75rem;
    color: var(--color-text-tertiary);
    text-align: right;
  }
</style>
