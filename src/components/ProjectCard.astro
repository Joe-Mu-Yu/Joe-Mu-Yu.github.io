---
interface Props {
    title: string;
    description: string;
    href: string;
    icon?: string;
    language?: string;
    stars?: number;
    forks?: number;
    updatedAt?: string;
    position?: string;
}

const { title, description, href, icon, language, stars = 0, forks = 0, updatedAt, position } =
    Astro.props;
const sourceLang = (value: string) => /[\u3400-\u9fff]/u.test(value) ? 'zh-CN' : 'en';
const titleId = `project-${position ?? '0'}-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---

<a
    href={href}
    class="project-card"
    target="_blank"
    rel="noopener noreferrer"
    data-reveal
    aria-labelledby={titleId}
>
    <span class="card-corner" aria-hidden="true">{position ?? ''}</span>

    <div class="project-head">
        {
            icon && (
                <span class="project-icon" aria-hidden="true">
                    {icon}
                </span>
            )
        }
        <h3 class="project-title" id={titleId} lang={sourceLang(title)}>{title}</h3>
        <span class="project-arrow" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M7 17 17 7"></path>
                <path d="M8 7h9v9"></path>
            </svg>
        </span>
    </div>

    <p class="project-description" lang={sourceLang(description)}>{description}</p>

    <div class="project-meta">
        {
            language && (
                <span class="project-language">
                    <span class="language-dot" aria-hidden="true" />
                    {language}
                </span>
            )
        }
        <div class="project-stats">
            {
                stars > 0 && (
                    <span class="stat">
                        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                        </svg>
                        {stars}
                    </span>
                )
            }
            {
                forks > 0 && (
                    <span class="stat">
                        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="18" r="3" />
                            <circle cx="6" cy="6" r="3" />
                            <circle cx="18" cy="6" r="3" />
                            <path d="M6 21V9a9 9 0 0 0 6 3" />
                            <path d="M18 9a9 9 0 0 0-6-3" />
                        </svg>
                        {forks}
                    </span>
                )
            }
        </div>
    </div>

    {
        updatedAt && (
            <p class="project-updated">
                <span data-i18n="projects.updated">更新于</span> {updatedAt}
            </p>
        )
    }
</a>

<style>
    .project-card {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 0.875rem;
        height: 100%;
        padding: 1.5rem;
        background: var(--color-bg-secondary);
        border: 1px solid var(--color-border);
        transition:
            transform 0.3s var(--ease-out),
            box-shadow 0.3s var(--ease-out),
            border-color 0.2s;
    }

    .project-card:hover {
        transform: translate(-3px, -3px);
        box-shadow: var(--shadow-lg);
        border-color: var(--color-text);
    }

    .card-corner {
        position: absolute;
        top: 0.75rem;
        right: 0.875rem;
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        letter-spacing: 0.14em;
        color: var(--color-text-tertiary);
    }

    .project-head {
        display: flex;
        align-items: center;
        gap: 0.625rem;
        padding-right: 2.5rem;
    }

    .project-icon {
        font-size: 1.125rem;
        line-height: 1;
        transition: transform 0.3s var(--ease-out);
    }

    .project-card:hover .project-icon {
        transform: rotate(-10deg) scale(1.1);
    }

    .project-title {
        font-family: var(--font-mono);
        font-size: 0.9375rem;
        font-weight: 700;
        color: var(--color-text);
        word-break: break-word;
    }

    .project-arrow {
        display: grid;
        place-items: center;
        width: 28px;
        height: 28px;
        margin-left: auto;
        color: var(--color-text-tertiary);
        opacity: 0;
        transform: translate(-4px, 4px);
        transition:
            opacity 0.25s,
            transform 0.3s var(--ease-out),
            color 0.2s;
    }

    .project-card:hover .project-arrow,
    .project-card:focus-visible .project-arrow {
        opacity: 1;
        transform: translate(0, 0);
        color: var(--color-primary);
    }

    .project-description {
        flex: 1;
        font-size: 0.875rem;
        line-height: 1.65;
        color: var(--color-text-secondary);
    }

    .project-meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        padding-top: 0.875rem;
        border-top: 1px solid var(--color-rule);
    }

    .project-language {
        display: inline-flex;
        align-items: center;
        gap: 0.4375rem;
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        letter-spacing: 0.06em;
        color: var(--color-text-tertiary);
    }

    .language-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--color-primary);
    }

    .project-stats {
        display: flex;
        gap: 0.75rem;
    }

    .stat {
        display: inline-flex;
        align-items: center;
        gap: 0.3125rem;
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        color: var(--color-text-tertiary);
    }

    .project-updated {
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        color: var(--color-text-tertiary);
        letter-spacing: 0.04em;
    }

    @media (max-width: 640px) {
        .project-arrow {
            opacity: 1;
            transform: none;
        }
    }
</style>
