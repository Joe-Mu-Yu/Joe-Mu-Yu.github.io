---
interface Props {
    title: string;
    description: string;
    date: Date;
    tags?: string[];
    href: string;
}

const { title, description, date, tags = [], href } = Astro.props;

const formattedDate = date.toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
});
const isoDate = date.toISOString();
---

<article class="article-card" data-reveal>
    <a href={href} class="card-link">
        <div class="card-body" lang="zh-CN">
            <div class="card-index">
                <time datetime={isoDate}>{formattedDate}</time>
            </div>
            <h3 class="card-title">{title}</h3>
            <p class="card-description">{description}</p>
            {
                tags.length > 0 && (
                    <div class="card-tags">
                        {tags.slice(0, 3).map((tag) => (
                            <span class="card-tag">#{tag}</span>
                        ))}
                    </div>
                )
            }
        </div>
        <span class="card-arrow" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14"></path>
                <path d="m13 6 6 6-6 6"></path>
            </svg>
        </span>
    </a>
</article>

<style>
    .article-card {
        border-top: 1px solid var(--color-rule);
        transition: border-color 0.25s var(--ease-snap);
    }

    .article-card:hover {
        border-top-color: var(--color-primary);
    }

    .card-link {
        position: relative;
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 1.5rem;
        align-items: start;
        padding: 1.75rem 0;
    }

    .card-index {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.1em;
        color: var(--color-text-tertiary);
        margin-bottom: 0.625rem;
    }

    .card-title {
        font-family: var(--font-display);
        font-size: 1.375rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        line-height: 1.25;
        color: var(--color-text);
        transition: color 0.2s var(--ease-snap);
        text-wrap: balance;
    }

    .card-link:hover .card-title {
        color: var(--color-primary);
    }

    .card-description {
        margin-top: 0.625rem;
        color: var(--color-text-secondary);
        font-size: 0.9375rem;
        line-height: 1.7;
        max-width: 60ch;
    }

    .card-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 1rem;
    }

    .card-tag {
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        letter-spacing: 0.06em;
        color: var(--color-text-tertiary);
    }

    .card-arrow {
        display: grid;
        place-items: center;
        width: var(--tap-target);
        height: var(--tap-target);
        margin-top: 1.25rem;
        border: 1px solid var(--color-border);
        color: var(--color-text-secondary);
        transform: translateX(-6px);
        opacity: 0;
        transition:
            transform 0.3s var(--ease-out),
            opacity 0.25s,
            border-color 0.2s,
            color 0.2s;
    }

    .card-link:hover .card-arrow,
    .card-link:focus-visible .card-arrow {
        opacity: 1;
        transform: translateX(0);
        color: var(--color-primary);
        border-color: var(--color-primary);
    }

    @media (max-width: 640px) {
        .card-link {
            padding: 1.5rem 0;
        }

        .card-title {
            font-size: 1.1875rem;
        }

        /* Always show the affordance when there is no hover to reveal it. */
        .card-arrow {
            opacity: 1;
            transform: none;
        }
    }
</style>
