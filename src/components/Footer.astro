---
const today = new Date();
const startDate = new Date('2024-01-01'); // 博客开始运行日期
const daysRunning = Math.floor((today.getTime() - startDate.getTime()) / (1000 * 60 * 60 * 24));
---

<footer>
  <div class="container">
    <p>
      &copy; {today.getFullYear()} Morgan. All rights reserved.
      <span class="separator">|</span>
      <a href="/rss.xml">RSS</a>
    </p>
    <p class="runtime">已运行 {daysRunning} 天</p>
  </div>
</footer>

<style>
  footer {
    padding: 3rem 0 2rem;
    margin-top: 6rem;
    text-align: center;
  }
  
  .container {
    padding: 1.5rem;
    max-width: var(--max-width);
    margin: 0 auto;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 24px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2), 0 8px 16px rgba(0, 0, 0, 0.1);
  }
  
  p {
    font-size: 0.875rem;
    color: var(--color-text-tertiary);
    line-height: 1.6;
  }
  
  a {
    color: var(--color-text-secondary);
    font-weight: 500;
    padding: 0.25rem 0.5rem;
    border-radius: 6px;
    transition: all 0.2s ease;
  }
  
  a:hover {
    color: var(--color-primary);
    background: var(--color-primary-light);
    text-decoration: none;
  }
  
  .separator {
    margin: 0 0.5rem;
    opacity: 0.3;
  }
  
  .runtime {
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    color: var(--color-text-tertiary);
    display: inline-block;
  }
</style>
