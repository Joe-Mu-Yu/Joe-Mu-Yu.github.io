---
import ThemeToggle from './ThemeToggle.astro';
import LanguageToggle from './LanguageToggle.astro';
---

<header>
  <div class="container header-inner">
    <a href="/" class="logo">Morgan</a>
    
    <nav>
      <ul>
        <li><a href="/" data-i18n="nav.home">首页</a></li>
        <li><a href="/posts" data-i18n="nav.posts">文章</a></li>
        <li><a href="/projects" data-i18n="nav.projects">项目</a></li>
        <li><a href="/life" data-i18n="nav.life">生活</a></li>
        <li><a href="/about" data-i18n="nav.about">关于</a></li>
        <li><LanguageToggle /></li>
        <li><ThemeToggle /></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 100;
    padding: 0.75rem 0;
  }
  
  .header-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1.25rem;
    
    /* 液态玻璃效果 - Apple Liquid Glass */
    background: var(--glass-bg);
    backdrop-filter: var(--backdrop-blur);
    -webkit-backdrop-filter: var(--backdrop-blur);
    border: 1px solid var(--glass-border);
    box-shadow: var(--shadow-glass);
    border-radius: var(--border-radius-lg);
    
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    margin: 0 1rem;
  }
  
  .header-inner:hover {
    background: var(--glass-bg-strong);
    box-shadow: var(--shadow-hover);
    border-color: rgba(255, 255, 255, 0.25);
  }
  
  .logo {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text);
    letter-spacing: -0.02em;
    transition: all 0.3s ease;
    padding: 0.5rem 0.75rem;
    border-radius: var(--border-radius-sm);
  }
  
  .logo:hover {
    color: var(--color-primary);
    background: var(--color-primary-light);
  }
  
  nav ul {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  
  nav a {
    font-size: 0.925rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    padding: 0.5rem 0.875rem;
    border-radius: var(--border-radius-sm);
    transition: all 0.2s ease;
    position: relative;
  }
  
  nav a:hover {
    color: var(--color-text);
    background: var(--color-bg-secondary);
  }
  
  nav a:active {
    transform: scale(0.98);
  }
  
  @media (max-width: 768px) {
    .header-inner {
      flex-direction: column;
      gap: 1rem;
      padding: 1rem;
    }
    
    nav ul {
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.375rem;
    }
    
    nav a {
      font-size: 0.875rem;
      padding: 0.4375rem 0.75rem;
    }
  }
</style>

<script>
  import { translations, type Language } from '../i18n/index.ts';

  function updateLanguage() {
    const lang = (localStorage.getItem('language') || 'zh') as Language;
    const elements = document.querySelectorAll('[data-i18n]');
    
    elements.forEach(el => {
      const key = el.getAttribute('data-i18n');
      if (key) {
        const keys = key.split('.');
        let value: any = translations[lang];
        
        for (const k of keys) {
          if (value && typeof value === 'object') {
            value = value[k];
          }
        }
        
        if (typeof value === 'string') {
          el.textContent = value;
        }
      }
    });
  }

  // 页面加载时更新语言
  updateLanguage();

  // 监听语言切换事件
  window.addEventListener('languageChanged', () => {
    updateLanguage();
  });
</script>
