---
// Rendered twice (desktop and mobile nav), so everything is wired through
// data attributes and a scoped query rather than a single element id.
---

<div class="language-selector" data-language-selector>
    <button
        type="button"
        class="control-button"
        aria-expanded="false"
        aria-haspopup="true"
        data-language-button
        data-i18n-attr="aria-label:nav.language"
        aria-label="切换语言：中文"
    >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M3 12h18"></path>
            <path d="M12 3a15 15 0 0 1 0 18a15 15 0 0 1 0-18z"></path>
        </svg>
        <span class="control-value" data-language-label>中文</span>
    </button>

    <div class="language-menu" data-language-menu hidden>
        <button type="button" class="language-option" data-lang="zh">中文</button>
        <button type="button" class="language-option" data-lang="en">English</button>
    </div>
</div>

<style>
    .language-selector {
        position: relative;
    }

    .control-button {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        min-height: var(--tap-target);
        padding: 0 0.75rem;
        background: transparent;
        border: 1px solid var(--color-border);
        color: var(--color-text-secondary);
        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.08em;
        cursor: pointer;
        transition:
            color 0.2s var(--ease-snap),
            border-color 0.2s var(--ease-snap);
    }

    .control-button:hover,
    .control-button[aria-expanded='true'] {
        color: var(--color-text);
        border-color: var(--color-text);
    }

    .language-menu {
        position: absolute;
        top: calc(100% + 6px);
        right: 0;
        min-width: 132px;
        background: var(--color-bg);
        border: 1px solid var(--color-border);
        box-shadow: var(--shadow-md);
        z-index: 120;
    }

    .language-menu[hidden] {
        display: none;
    }

    .language-option {
        display: block;
        width: 100%;
        min-height: var(--tap-target);
        padding: 0 1rem;
        background: transparent;
        border: none;
        text-align: left;
        font-size: 0.875rem;
        color: var(--color-text-secondary);
        cursor: pointer;
        transition: background-color 0.15s, color 0.15s;
    }

    .language-option:hover {
        background: var(--color-primary-light);
        color: var(--color-text);
    }

    .language-option[aria-current='true'] {
        color: var(--color-primary);
        font-weight: 700;
    }
</style>

<script>
    import { getCurrentLanguage, applyTranslations } from '../i18n/index.ts';

    const LABELS: Record<string, string> = { zh: '中文', en: 'EN' };

    document.querySelectorAll('[data-language-selector]').forEach((selector) => {
        const button = selector.querySelector('[data-language-button]');
        const menu = selector.querySelector('[data-language-menu]');
        const label = selector.querySelector('[data-language-label]');
        if (!button || !menu) return;

        const sync = () => {
            const lang = getCurrentLanguage();
            if (label) label.textContent = LABELS[lang] ?? lang;
            menu.querySelectorAll('[data-lang]').forEach((option) => {
                if (option.getAttribute('data-lang') === lang) {
                    option.setAttribute('aria-current', 'true');
                } else {
                    option.removeAttribute('aria-current');
                }
            });
        };

        const setOpen = (open: boolean) => {
            button.setAttribute('aria-expanded', String(open));
            menu.hidden = !open;
        };

        sync();

        button.addEventListener('click', (event) => {
            event.stopPropagation();
            setOpen(button.getAttribute('aria-expanded') !== 'true');
        });

        menu.addEventListener('click', (event) => {
            const option = (event.target as HTMLElement).closest('[data-lang]');
            if (!option) return;
            const lang = option.getAttribute('data-lang');
            if (!lang || lang === getCurrentLanguage()) {
                setOpen(false);
                return;
            }
            localStorage.setItem('language', lang);
            applyTranslations();
            window.dispatchEvent(new CustomEvent('languageChanged', { detail: { language: lang } }));
            setOpen(false);
        });

        document.addEventListener('click', (event) => {
            if (!selector.contains(event.target as Node)) setOpen(false);
        });

        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') {
                setOpen(false);
                button.focus();
            }
        });

        window.addEventListener('languageChanged', sync);
    });
</script>
