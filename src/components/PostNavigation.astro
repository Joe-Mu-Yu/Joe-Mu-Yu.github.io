---
interface PostLink {
    title: string;
    href: string;
}

interface Props {
    prevPost: PostLink | null;
    nextPost: PostLink | null;
}

const { prevPost, nextPost } = Astro.props;
---

<nav class="post-nav" aria-label="文章导航" data-i18n-attr="aria-label:post.navigationLabel" data-interface-lang lang="zh-CN">
    {
        prevPost ? (
            <a href={prevPost.href} class="nav-card nav-prev">
                <span class="nav-label">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="15 18 9 12 15 6"></polyline>
                    </svg>
                    <span data-i18n="post.prev">上一篇</span>
                </span>
                <span class="nav-title" lang="zh-CN">{prevPost.title}</span>
            </a>
        ) : (
            <span class="nav-placeholder" aria-hidden="true"></span>
        )
    }

    <a href="/posts" class="nav-all">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="3" width="7" height="7"></rect>
            <rect x="14" y="3" width="7" height="7"></rect>
            <rect x="14" y="14" width="7" height="7"></rect>
            <rect x="3" y="14" width="7" height="7"></rect>
        </svg>
        <span data-i18n="post.allPosts">全部文章</span>
    </a>

    {
        nextPost ? (
            <a href={nextPost.href} class="nav-card nav-next">
                <span class="nav-label">
                    <span data-i18n="post.next">下一篇</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                </span>
                <span class="nav-title" lang="zh-CN">{nextPost.title}</span>
            </a>
        ) : (
            <span class="nav-placeholder" aria-hidden="true"></span>
        )
    }
</nav>

<style>
    .post-nav {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        gap: 1.5rem;
        align-items: stretch;
        margin-top: 4rem;
        padding-top: 2rem;
        border-top: 1px solid var(--color-rule);
    }

    .nav-card {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        padding: 1.125rem 0;
        text-decoration: none;
        min-height: 76px;
    }

    .nav-card:hover .nav-title,
    .nav-card:focus-visible .nav-title {
        color: var(--color-primary);
    }

    .nav-next {
        text-align: right;
    }

    .nav-label {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        letter-spacing: 0.12em;
        color: var(--color-text-tertiary);
    }

    .nav-next .nav-label {
        justify-content: flex-end;
    }

    .nav-title {
        font-family: var(--font-display);
        font-size: 1.0625rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        line-height: 1.35;
        color: var(--color-text);
        transition: color 0.2s var(--ease-snap);
        text-wrap: balance;
    }

    .nav-all {
        display: inline-flex;
        align-items: center;
        align-self: center;
        justify-content: center;
        gap: 0.5rem;
        min-height: var(--tap-target);
        padding: 0 1rem;
        border: 1px solid var(--color-border);
        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.08em;
        color: var(--color-text-secondary);
        text-decoration: none;
        white-space: nowrap;
        transition:
            color 0.2s var(--ease-snap),
            border-color 0.2s var(--ease-snap);
    }

    .nav-all:hover,
    .nav-all:focus-visible {
        color: var(--color-primary);
        border-color: var(--color-primary);
    }

    @media (max-width: 720px) {
        .post-nav {
            grid-template-columns: 1fr 1fr;
            gap: 1.25rem;
        }

        .nav-all {
            grid-column: 1 / -1;
            grid-row: 1;
            justify-self: start;
        }

        .nav-next {
            text-align: left;
        }

        .nav-next .nav-label {
            justify-content: flex-start;
        }
    }
</style>
