---
interface PostLink {
  title: string;
  href: string;
}

interface Props {
  prevPost: PostLink | null;
  nextPost: PostLink | null;
}

const { prevPost, nextPost } = Astro.props;
---

<nav class="post-nav">
  {prevPost ? (
    <a href={prevPost.href} class="nav-card glass-nav-card nav-prev">
      <div class="nav-edge-light"></div>
      <span class="nav-label">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
        上一篇
      </span>
      <span class="nav-title">{prevPost.title}</span>
    </a>
  ) : <div class="nav-placeholder"></div>}

  <a href="/posts" class="nav-back glass-btn">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="3" width="7" height="7"></rect>
      <rect x="14" y="3" width="7" height="7"></rect>
      <rect x="14" y="14" width="7" height="7"></rect>
      <rect x="3" y="14" width="7" height="7"></rect>
    </svg>
    所有文章
  </a>

  {nextPost ? (
    <a href={nextPost.href} class="nav-card glass-nav-card nav-next">
      <div class="nav-edge-light"></div>
      <span class="nav-label">
        下一篇
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </span>
      <span class="nav-title">{nextPost.title}</span>
    </a>
  ) : <div class="nav-placeholder"></div>}
</nav>

<style>
  .post-nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1rem;
    margin-top: 1.5rem;
    align-items: stretch;
  }

  /* 导航卡片 - 液态玻璃 */
  .nav-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem 1.5rem;
    border-radius: var(--border-radius);
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    overflow: hidden;
    min-height: 80px;
  }

  .nav-edge-light {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 255, 255, 0.35) 50%,
      transparent 100%
    );
    pointer-events: none;
    z-index: 2;
  }

  .nav-card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.1) 0%,
      rgba(255, 255, 255, 0.02) 50%,
      rgba(255, 255, 255, 0.08) 100%
    );
    opacity: 0.5;
    pointer-events: none;
    mix-blend-mode: overlay;
  }

  .nav-prev {
    text-align: left;
  }

  .nav-next {
    text-align: right;
  }

  .nav-label {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    position: relative;
    z-index: 1;
  }

  .nav-next .nav-label {
    flex-direction: row-reverse;
  }

  .nav-title {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    position: relative;
    z-index: 1;
    transition: color 0.2s ease;
  }

  .nav-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-hover);
    border-color: rgba(255, 255, 255, 0.25);
  }

  .nav-card:hover .nav-title {
    color: var(--color-primary);
  }

  .nav-back {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    padding: 1rem;
    border-radius: var(--border-radius);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-text-tertiary);
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    white-space: nowrap;
  }

  .nav-back:hover {
    color: var(--color-text);
    transform: translateY(-2px);
    box-shadow: var(--shadow-hover);
  }

  .nav-placeholder {
    /* 占位保持网格布局 */
  }

  @media (max-width: 768px) {
    .post-nav {
      grid-template-columns: 1fr 1fr;
      gap: 0.75rem;
    }

    .nav-back {
      grid-column: 1 / -1;
      flex-direction: row;
      padding: 0.75rem;
    }

    .nav-card {
      padding: 1rem;
      min-height: 70px;
    }

    .nav-title {
      font-size: 0.875rem;
    }
  }
</style>
